# Copy to .env and fill in. Used by the side-app scripts. Never commit .env.

# --- spotify_gemini_playlist.py ---
# Spotify app credentials: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# OpenRouter (Gemini) key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- openclaw.py ---
# Google Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
